# Existing Facebook Page auto-posting
FB_PAGE_ID=your-facebook-page-id
FB_PAGE_ACCESS_TOKEN=your-page-access-token
FB_GRAPH_VERSION=v25.0
POSTS_FILE=posts/posts.json
DRY_RUN=true
# POST_TEXT=Hello from GitHub Actions
# POST_LINK=https://example.com
# POST_INDEX=0

# Community property aggregation to Notion
PROPERTY_SOURCE_PATH=samples/community_posts.csv
PROPERTY_SOURCE_TYPE=auto
PROPERTY_OUTPUT_PATH=outputs/property-listings.json
PROPERTY_MIN_CONFIDENCE=0.35
PROPERTY_SYNC_DRY_RUN=true
NOTION_SYNC=false
NOTION_API_KEY=secret_xxx
NOTION_DATA_SOURCE_ID=your-notion-data-source-id
# Legacy only, prefer NOTION_DATA_SOURCE_ID for Notion API 2026-03-11
# NOTION_DATABASE_ID=your-legacy-database-id
NOTION_VERSION=2026-03-11

# Optional, only for explicitly approved Graph API access. Broad Facebook Groups API access was removed by Meta.
# FACEBOOK_GROUP_IDS=123,456
# FB_USER_ACCESS_TOKEN=your-approved-token
# FACEBOOK_GROUP_LIMIT=25
